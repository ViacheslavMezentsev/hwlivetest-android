<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Чтение системного журнала для диагностики USB. Выдаётся только вручную через adb:
         adb shell pm grant io.github.viacheslavmezentsev.hwlivetest android.permission.READ_LOGS -->
    <uses-permission
        android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />

    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
        android:name=".HwApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".SimpleActivity"
            android:theme="@style/AppTheme.Compose"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>

            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/stlink_device_filter" />
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/menu_expert"
            android:theme="@style/AppTheme.Compose"
            android:parentActivityName=".SimpleActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="@string/about_title"
            android:theme="@style/AppTheme.Compose" />

        <activity
            android:name=".TargetActivity"
            android:exported="false"
            android:label="@string/target_title"
            android:theme="@style/AppTheme.Compose" />

        <activity
            android:name=".FlashActivity"
            android:exported="false"
            android:label="@string/flash_title"
            android:theme="@style/AppTheme.Compose" />

        <activity
            android:name=".LogicActivity"
            android:exported="false"
            android:label="@string/la_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ChartActivity"
            android:exported="false"
            android:label="@string/chart_title"
            android:parentActivityName=".MainActivity" />
    </application>
</manifest>
