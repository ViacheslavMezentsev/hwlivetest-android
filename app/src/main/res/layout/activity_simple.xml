<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/simpleStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/simple_hint"
            android:textSize="15sp" />

        <io.github.viacheslavmezentsev.hwlivetest.StartButton
            android:id="@+id/startButton"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/start" />

        <TextView
            android:id="@+id/stepText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_tools" />

        <Button
            android:id="@+id/toolBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tool_backup" />

        <Button
            android:id="@+id/toolCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tool_check" />

        <Button
            android:id="@+id/toolFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tool_fields" />

        <TextView
            android:id="@+id/toolResult"
            style="@style/InfoBlock" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tool_write_note"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
